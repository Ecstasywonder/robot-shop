{
  "uid": "robot-shop-red",
  "title": "Robot Shop - Gateway RED",
  "description": "Gateway-only RED signals for web, catalogue, cart, and payment. Request timing includes health/root traffic and the payment stub; it does not represent internal RPC timing. No general PII is displayed.",
  "schemaVersion": 41,
  "version": 1,
  "tags": ["robot-shop", "gateway", "red"],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Gateway RPS",
      "description": "Aggregate requests per second across the four gateway services.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(robotshop_http_requests_total{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m]))",
          "legendFormat": "RPS",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "N/A",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Gateway 5xx ratio",
      "description": "Error rate divided by request rate. No denominator clamp is used, so idle services remain no-data/NaN.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(rate(robotshop_http_errors_total{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m])) or on() (sum(rate(robotshop_http_requests_total{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m])) * 0)) / sum(rate(robotshop_http_requests_total{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m])))",
          "legendFormat": "5xx ratio",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "noValue": "N/A",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Gateway p95 latency",
      "description": "95th percentile gateway request duration across the four services.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(robotshop_http_request_duration_seconds_bucket{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m])))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "noValue": "N/A",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fluent Bit collector",
      "description": "Collector metrics endpoint availability; N/A means the series is absent.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{namespace=\"log-collection\",service=\"fluent-bit\",endpoint=\"metrics\"})",
          "legendFormat": "collector",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "N/A",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per second by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(robotshop_http_requests_total{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m]))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "noValue": "N/A" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "web" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "catalogue" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "cart" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "payment" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "5xx ratio by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (service) (rate(robotshop_http_errors_total{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m])) or on(service) (sum by (service) (rate(robotshop_http_requests_total{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m])) * 0)) / sum by (service) (rate(robotshop_http_requests_total{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m]))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2, "noValue": "N/A" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "web" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "catalogue" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "cart" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "payment" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 latency by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(robotshop_http_request_duration_seconds_bucket{namespace=\"log-collection\",service=~\"web|catalogue|cart|payment\"}[5m])))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3, "noValue": "N/A" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "web" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "catalogue" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "cart" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "payment" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } }
    }
  ]
}
