# Entrypoint compatibility: the image may remove these three leading lines.
# Instana tracing is intentionally disabled for the course deployment.
# Active Nginx configuration starts below this compatibility prefix.

map $request_method $observed_method {
    default OTHER;
    GET GET;
    POST POST;
    PUT PUT;
    PATCH PATCH;
    DELETE DELETE;
    HEAD HEAD;
    OPTIONS OPTIONS;
}

map $status $observed_level {
    default info;
    ~^4 warn;
    ~^5 error;
}

map $uri $observed_service {
    default web;
    ~^/api/catalogue(?:/|$) catalogue;
    ~^/api/cart(?:/|$) cart;
    ~^/api/payment(?:/|$) payment;
    ~^/api/ other;
}

log_format robotshop_access escape=json
    '{"event":"http_access","service":"web","target_service":"$observed_service",'
    '"method":"$observed_method","status":"$status",'
    '"request_time":$request_time,"level":"$observed_level"}';

server {
    listen 8080;
    server_name localhost;
    proxy_http_version 1.1;
    access_log /dev/stdout robotshop_access;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        ssi on;
    }

    location /images/ {
        expires 5s;
        root /usr/share/nginx/html;
        try_files $uri /images/placeholder.png;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }

    location /api/catalogue/ {
        proxy_pass http://${CATALOGUE_HOST}:8080/;
    }
    location /api/user/ {
        proxy_pass http://${USER_HOST}:8080/;
    }
    location /api/cart/ {
        proxy_pass http://${CART_HOST}:8080/;
    }
    location /api/shipping/ {
        proxy_pass http://${SHIPPING_HOST}:8080/;
    }
    location /api/payment/ {
        proxy_pass http://${PAYMENT_HOST}:8080/;
    }
    location /api/ratings/ {
        proxy_pass http://${RATINGS_HOST}:80/;
    }

    location /nginx_status {
        stub_status on;
        access_log off;
    }
}
